{
  "name": "tilawa-coach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Personal recitation tutor (Quran, tajweed, latmiya, shoor) plus a private career desk. Offline-first PWA.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "guard": "node scripts/repo-guard.ts",
    "content:lint": "node scripts/lesson-index.ts --check && node scripts/content-lint.ts",
    "data:fetch": "node scripts/fetch-sources.ts",
    "data:build": "node scripts/build-quran-data.ts",
    "e2e": "playwright test",
    "ci": "npm run guard && npm run typecheck && npm run lint && npm run test && npm run content:lint && npm run build"
  },
  "dependencies": {
    "@preact/signals": "2.11.4",
    "idb": "8.0.4",
    "preact": "10.29.8",
    "ts-fsrs": "6.0.0",
    "workbox-window": "7.4.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "fake-indexeddb": "6.2.8",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.1",
    "workbox-build": "7.4.1"
  }
}
